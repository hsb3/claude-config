#!/bin/sh
# Self-check for install.sh. Uses a temp HOME and config dir and a stub `claude`, so the real ~/.claude is never touched.
repo="$(cd "$(dirname "$0")/.." && pwd)"
t="$(mktemp -d)"; trap 'rm -rf "$t"' EXIT
mkdir -p "$t/stub"
printf '#!/bin/sh\necho "ponytail@p i-have-adhd@i egm@e"\n' > "$t/stub/claude"; chmod +x "$t/stub/claude"
export HOME="$t/home" CLAUDE_CONFIG_DIR="$t/cfg" PATH="$t/stub:$PATH"
cfg="$t/cfg"
fail=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }
run() { "$repo/install.sh" >"$t/out" 2>&1; code=$?; }

run;  check "fresh install succeeds"           '[ $code -eq 0 ]'
      check "fresh install copies globals"     'for f in CLAUDE.md AGENTS.md .i-have-adhd-always settings.json; do cmp -s "$repo/global/$f" "$cfg/$f" || exit 1; done'
      check "fresh install copies modes, cmode" '[ -f "$cfg/modes/design/prompt.md" ] && [ -x "$HOME/.local/bin/cmode" ]'
run;  check "re-run reports nothing changed"   '[ $code -eq 0 ] && ! grep -qE "^(added|changed|differs)" "$t/out"'
      check "re-run leaves no .bak"            '! ls "$cfg"/*.bak >/dev/null 2>&1'
echo '{"model":"mine"}' > "$cfg/settings.json"; echo "old rules" > "$cfg/AGENTS.md"
run;  check "differing settings kept"          '[ $code -eq 0 ] && [ "$(cat "$cfg/settings.json")" = "{\"model\":\"mine\"}" ]'
      check "differing settings shows diff"    'grep -q "^differs" "$t/out" && grep -q "^-{\"model\":\"mine\"}" "$t/out"'
      check "AGENTS.md overwritten, old kept"  'cmp -s "$repo/global/AGENTS.md" "$cfg/AGENTS.md" && [ "$(cat "$cfg/AGENTS.md.bak")" = "old rules" ]'
exit $fail
